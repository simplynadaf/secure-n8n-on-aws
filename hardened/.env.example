# Environment for the HARDENED stack (hardened/docker-compose.yml).
#
# In production, do NOT create a real .env from this. Instead run
# scripts/load-secrets.sh, which pulls N8N_ENCRYPTION_KEY and POSTGRES_PASSWORD from
# AWS Secrets Manager into the environment at runtime, so they never touch disk.
#
# This file only documents what each variable is. If you DO use a .env on disk for a
# quick local test, lock it down:  chmod 600 .env && chown root:root .env
# and never commit it (.gitignore already ignores .env / *.env).

# The public hostname n8n serves on (must match the domain in hardened/Caddyfile).
# Used for N8N_HOST and WEBHOOK_URL=https://${N8N_HOST}/.
N8N_HOST=n8n.example.com

# n8n's credential-encryption key. Generate with:  openssl rand -hex 32
# Without it, n8n derives a default key = stored credentials are effectively unencrypted.
# Back this up separately: losing it means losing access to every stored credential.
# In production this comes from AWS Secrets Manager (secret: n8n/encryption-key).
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Password for the bundled Postgres. Generate a strong random one.
# In production this comes from AWS Secrets Manager (secret: n8n/postgres-password).
POSTGRES_PASSWORD=replace-with-a-strong-random-password
